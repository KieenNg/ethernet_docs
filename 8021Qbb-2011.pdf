               <rdf:li>local area networks</rdf:li>
               <rdf:li>MAC Bridges</rdf:li>
               <rdf:li>priority</rdf:li>
               <rdf:li>transparent bridging</rdf:li>
               <rdf:li>VLANs</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">IEEE Std 802.1Qbbâ„¢-2011, IEEE Standard for Local and metropolitan area networksâ€”Media Access Control (MAC) Bridges and Virtual Bridged Local Area Networksâ€”Amendment 17: Priority-based Flow Control</rdf:li>
            </rdf:Alt>
         </dc:title>
